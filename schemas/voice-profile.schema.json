{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worklore.local/schemas/voice-profile.schema.json",
  "title": "WorkLore Voice Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "voiceProfileId",
    "explicitInstructions",
    "observations",
    "sampleRefs",
    "createdAt",
    "updatedAt",
    "revision"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "voiceProfileId": {
      "type": "string",
      "pattern": "^voice_[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "default": "Default"
    },
    "explicitInstructions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instructionId",
          "text",
          "priority",
          "enabled"
        ],
        "properties": {
          "instructionId": {
            "type": "string",
            "pattern": "^instruction_[A-Za-z0-9_-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observationId",
          "category",
          "value",
          "confidence",
          "sourceIds"
        ],
        "properties": {
          "observationId": {
            "type": "string",
            "pattern": "^observation_[A-Za-z0-9_-]+$"
          },
          "category": {
            "type": "string",
            "enum": [
              "formality",
              "directness",
              "humor",
              "sentence_length",
              "paragraph_shape",
              "technical_depth",
              "vocabulary",
              "formatting",
              "common_pattern",
              "avoidance",
              "audience",
              "other"
            ]
          },
          "value": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^source_[A-Za-z0-9_-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "sampleRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "locator",
          "excerpt",
          "useCases"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^source_[A-Za-z0-9_-]+$"
          },
          "locator": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "useCases": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "linkedin",
                "resume",
                "technical",
                "interview",
                "general"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
