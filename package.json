{
  "name": "worklore",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Channel qa",
    "build:frontend": "tsc -b && vite build",
    "validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Channel validate -SkipBundle",
    "qa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-qa.ps1 -Launch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "desktop:dev:raw": "tauri dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Channel qa"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.8.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
